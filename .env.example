# ==============================================
# CivicShield - Environment Configuration Template
# Copy this file to .env and fill in real values.
# NEVER commit your actual .env file to version control.
# ==============================================

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
DATABASE_URL=sqlite:///./civicshield.db

# AI / Model Configuration
YOLO_MODEL_PATH=models/civicshield_yolov8.pt
CONFIDENCE_THRESHOLD=0.45
IOU_THRESHOLD=0.50
DEVICE=cpu  # 'cpu', 'cuda', or 'mps'

# Geolocation & Deduplication
DEDUPLICATION_RADIUS_METERS=15.0
DUPLICATE_TIME_WINDOW_HOURS=72

# Storage & Uploads
UPLOAD_DIR=data/uploads
PROCESSED_DIR=data/processed

# Optional External API Keys (e.g. Mapbox, Cloud Storage, or Notification Services)
GEOCODING_API_KEY=
MAPS_API_KEY=
